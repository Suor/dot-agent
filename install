#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
import types
from importlib.machinery import SourceFileLoader
from pathlib import Path


ROOT = Path(__file__).resolve().parent


def main(argv: list[str]) -> int:
    module = types.ModuleType("dot_agent")
    module.__file__ = str(ROOT / "dot-agent")
    sys.modules[module.__name__] = module
    SourceFileLoader(module.__name__, module.__file__).exec_module(module)

    parser = argparse.ArgumentParser(description="Install dot-agent artifacts")
    parser.add_argument("where", choices=["claude", "codex", "all"], help="where to install")
    skills = parser.add_mutually_exclusive_group(required=True)
    skills.add_argument("--all-skills", action="store_true", help="install all skills")
    skills.add_argument("-s", "--skill", action="append", dest="skills", help="skill to install; may repeat")
    parser.add_argument("--dry-run", action="store_true", help="print actions without changing files")
    args = parser.parse_args(argv)

    names = [] if args.all_skills else args.skills
    try:
        module.install_skills(args.where, names, args.dry_run)
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
